<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android">
    <!-- Surface base: white in light, near-black in dark -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/about_hero_base" />
        </shape>
    </item>
    <!-- Tint wash: primary container fading down into the surface -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="?androidprv:attr/materialColorPrimaryContainer"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
