<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
    android:id="@+id/about_device_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- ===== Hero card ===== -->
    <LinearLayout
        android:id="@+id/about_hero_card"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="22dp"
        android:background="@drawable/about_device_hero_bg">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/about_model_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:maxLines="2"
            android:gravity="center"
            android:textColor="?androidprv:attr/materialColorOnPrimaryContainer" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/about_os_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_device_os_version"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?androidprv:attr/materialColorOnPrimaryContainer" />
    </LinearLayout>

    <!-- ===== Grid row: device name + storage ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:baselineAligned="false">

        <!-- Device name card -->
        <LinearLayout
            android:id="@+id/about_device_name_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="125dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/about_card_bg">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_about_phone"
                app:tint="?androidprv:attr/materialColorOnSurface" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_device_info_device_name_preference_title"
                android:textSize="13.5sp"
                android:textColor="?androidprv:attr/materialColorOnSurfaceVariant" />

            <TextView
                android:id="@+id/about_device_name_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="?androidprv:attr/materialColorOnSurface" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <!-- Storage card -->
        <LinearLayout
            android:id="@+id/about_storage_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="125dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/about_card_bg">

            <ProgressBar
                android:id="@+id/about_storage_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/about_device_storage_progress" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storage_settings"
                android:textSize="13.5sp"
                android:textColor="?androidprv:attr/materialColorOnSurfaceVariant" />

            <TextView
                android:id="@+id/about_storage_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:textColor="?androidprv:attr/materialColorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Specifications card ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@drawable/about_card_bg">

        <!-- Processor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="15dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_spec_processor"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="?androidprv:attr/materialColorOnSurface" />

            <TextView
                android:id="@+id/about_processor_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:textSize="13.5sp"
                android:gravity="end"
                android:maxLines="2"
                android:textColor="?androidprv:attr/materialColorOnSurfaceVariant" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?androidprv:attr/materialColorOutlineVariant" />

        <!-- Battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="15dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_spec_battery"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="?androidprv:attr/materialColorOnSurface" />

            <TextView
                android:id="@+id/about_battery_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13.5sp"
                android:textColor="?androidprv:attr/materialColorOnSurfaceVariant" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?androidprv:attr/materialColorOutlineVariant" />

        <!-- RAM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="15dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_spec_ram"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="?androidprv:attr/materialColorOnSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/about_ram_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textColor="?androidprv:attr/materialColorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_about_chevron"
                    app:tint="?androidprv:attr/materialColorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
